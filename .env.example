# scripts/dev-init.sh generates .env with a unique secret and local root password.
EDP_ENV=development
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://edp:edp-local-only@localhost:15432/edp?sslmode=disable
LISTEN_ADDR=:8080
SECRET_KEY=
ROOT_USERNAME=root
ROOT_PASSWORD=
# Optional precomputed Argon2id hash instead of ROOT_PASSWORD; used only on initial seed.
ROOT_PASSWORD_HASH=
# Optional one-time migration input. Configure named relays in Settings afterwards.
SMTP_ADDR=localhost:1025
SMTP_TLS=none
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_SCOPES=openid profile email groups offline_access
OIDC_GROUPS_CLAIM=groups
OIDC_CLIENT_SECRET=
# Mount a Google service-account JSON at secrets/google-service-account.json.
# In Docker, set GOOGLE_CREDENTIALS_FILE=/run/secrets/google-service-account.json.
GOOGLE_CREDENTIALS_FILE=
BOUNCE_DOMAIN=
RETENTION_DAYS=30

# Optional independent bearer token for Prometheus /metrics.
METRICS_TOKEN=

OIDC_PROVIDER_NAME=Single sign-on
SEED_CERTIFICATES_FILE=
SEED_LOGO_FILE=
# Optional PMG tracking. Use an audit-role account; no queue writes are performed.
PMG_URL=
PMG_USERNAME=
PMG_PASSWORD=
PMG_NODES=
PMG_CA_FILE=
# Legacy upgrade input only; fallback is configured on named relays afterwards.
SECONDARY_SMTP_ADDR=
SECONDARY_SMTP_TLS=starttls
SECONDARY_SMTP_USERNAME=
SECONDARY_SMTP_PASSWORD=

# Connection credentials may instead be configured in Settings after root login.
