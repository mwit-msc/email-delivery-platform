EDP_ENV=production
PUBLIC_URL=https://edp.example.org
DATABASE_URL=postgres://edp:REPLACE_ME@database:5432/edp?sslmode=verify-full
LISTEN_ADDR=:8080
SECRET_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
ROOT_USERNAME=root
ROOT_PASSWORD=REPLACE_WITH_UNIQUE_LONG_PASSWORD
ROOT_PASSWORD_HASH=
# Optional one-time migration input. Configure named relays in Settings afterwards.
SMTP_ADDR=
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_SCOPES=openid profile email groups offline_access
OIDC_GROUPS_CLAIM=groups
OIDC_CLIENT_SECRET=
GOOGLE_CREDENTIALS_FILE=
BOUNCE_DOMAIN=
METRICS_TOKEN=REPLACE_WITH_UNIQUE_MONITORING_TOKEN
RETENTION_DAYS=30

OIDC_PROVIDER_NAME=Single sign-on
SEED_CERTIFICATES_FILE=
SEED_LOGO_FILE=
PMG_URL=
PMG_USERNAME=
PMG_PASSWORD=
PMG_NODES=
PMG_CA_FILE=
SECONDARY_SMTP_ADDR=
SECONDARY_SMTP_TLS=starttls
SECONDARY_SMTP_USERNAME=
SECONDARY_SMTP_PASSWORD=

# Connection credentials may instead be configured in Settings after root login.
